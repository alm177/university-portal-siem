# Flask
SECRET_KEY=
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
ALLOW_INSECURE_DEMO_CONFIG=false

# Database
DATABASE=database.db

# Seeded admin account
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@uni.local
DEFAULT_ADMIN_PASSWORD=

# OpenSearch / SIEM
OS_URL=https://localhost:9200
OS_INDEX=uni-auth-logs
OS_USER=admin
OS_PASS=
OS_VERIFY_SSL=false
TRUST_PROXY_HEADERS=false

# Rate limiting
LOGIN_THRESHOLD=5
REGISTER_THRESHOLD=5
RESET_THRESHOLD=3
WINDOW_MINUTES=2
LOCK_MINUTES=30
RESET_WINDOW_MINUTES=10

# Session timeout
SESSION_IDLE_MINUTES=1
SESSION_ABSOLUTE_HOURS=3

# DoS protection
DOS_WARNING_THRESHOLD=60
DOS_BLOCK_THRESHOLD=120
DOS_WINDOW_SECONDS=60
DOS_BLOCK_MINUTES=5

# Verification codes
RESET_TOKEN_EXPIRE_MINUTES=15
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5

# Security headers
SECURITY_HEADERS_ENABLED=true

# SMTP is optional for basic login/course demos.
# Email verification and password reset delivery require SMTP.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@uni.local
